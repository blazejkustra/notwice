#!/usr/bin/env node
import { readFileSync, writeFileSync } from 'node:fs'

const stateFile = process.env.FAKE_GH_STATE
const state = load()
const [group, action, ...rest] = process.argv.slice(2)
state.calls.push(process.argv.slice(2))

function load() {
  try {
    return JSON.parse(readFileSync(stateFile, 'utf8'))
  } catch {
    return { calls: [], prs: [] }
  }
}

function save() {
  writeFileSync(stateFile, JSON.stringify(state, null, 2))
}

function option(names) {
  const index = rest.findIndex((arg) => names.includes(arg))
  if (index >= 0) return rest[index + 1]
  const inline = rest.find((arg) => names.some((name) => arg.startsWith(`${name}=`)))
  return inline?.slice(inline.indexOf('=') + 1)
}

function body() {
  const file = option(['--body-file', '-F'])
  if (file) return readFileSync(file === '-' ? 0 : file, 'utf8')
  return option(['--body', '-b'])
}

function findPr() {
  const number = Number(rest.find((arg) => /^\d+$/.test(arg)))
  return number ? state.prs.find((pr) => pr.number === number) : state.prs.find((pr) => pr.state === 'OPEN')
}

const CHECKS = 'build\tpass\t41s\thttps://github.com/example/repo/actions/runs/1\ntest\tpass\t1m3s\thttps://github.com/example/repo/actions/runs/2'

function checksReadyIn() {
  state.checksStartedAt ??= Date.now()
  return state.checksStartedAt + (state.checkSeconds ?? 0) * 1000 - Date.now()
}

function waitForChecks() {
  const wait = checksReadyIn()
  save()
  if (wait > 0) Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, wait)
  Object.assign(state, load())
}

function checks() {
  if (rest.includes('--watch')) waitForChecks()
  if (checksReadyIn() > 0) {
    console.log(CHECKS.replaceAll('pass', 'pending'))
    return 8
  }
  console.log(CHECKS)
  return 0
}

function runs() {
  if (action !== 'watch') return 0
  waitForChecks()
  console.log("✓ main CI · 1\nTriggered via push\n\nJOBS\n✓ build in 41s\n✓ test in 1m3s")
  return 0
}

function main() {
  if (process.env.FAKE_GH_OFFLINE) {
    console.error('error connecting to api.github.com')
    return 1
  }
  if (group === 'run') return runs()
  if (group !== 'pr') return 0
  if (action === 'list') {
    console.log(JSON.stringify(state.prs.filter((pr) => pr.state === 'OPEN').map((pr) => ({ number: pr.number }))))
    return 0
  }
  if (action === 'checks') return checks()
  if (action === 'create') {
    const pr = { number: state.prs.length + 1, title: option(['--title', '-t']) ?? '', body: body() ?? '', state: 'OPEN' }
    state.prs.push(pr)
    console.log(`https://github.com/example/repo/pull/${pr.number}`)
    return 0
  }
  const pr = findPr()
  if (!pr) {
    console.error('no pull requests found for branch')
    return 1
  }
  if (action === 'view') {
    console.log(JSON.stringify(pr))
    return 0
  }
  if (action === 'edit') {
    pr.title = option(['--title', '-t']) ?? pr.title
    pr.body = body() ?? pr.body
    return 0
  }
  if (action === 'close') {
    pr.state = 'CLOSED'
    pr.closeComment = option(['--comment', '-c']) ?? null
    console.log(`Closed pull request #${pr.number}`)
    return 0
  }
  return 0
}

process.exitCode = main()
save()
